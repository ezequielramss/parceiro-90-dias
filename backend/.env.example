# Copie para .env (que o Git ignora) e preencha. Nunca coloque valores neste arquivo.
# Canal do WhatsApp: evolution (padrão) ou simulador (chat local em http://localhost:8080/simulador).
# Propriedade parceiro.whatsapp.canal.
WHATSAPP_CANAL=

# Evolution API (obrigatórias só com WHATSAPP_CANAL=evolution). Passo a passo em evolution/README.md.
# URL da API (ex.: http://localhost:8081), chave do cabeçalho apikey, nome da instância e o segredo
# que a Evolution envia no cabeçalho X-Webhook-Secret do webhook.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
EVOLUTION_WEBHOOK_SECRET=

# Conexão de servidor com o Postgres do Supabase (jdbc:postgresql://host:porta/postgres)
DATABASE_URL=
DATABASE_USER=
DATABASE_PASSWORD=

# Classificação de relatos pelo Gemini (Google AI Studio). A chave vai só no cabeçalho.
GEMINI_API_KEY=
GEMINI_MODEL=

# Dashboard (opcional): login pelo Supabase Auth. Sem estas duas, o painel responde 503 e o WhatsApp funciona.
# URL do projeto (https://<ref>.supabase.co) e a chave publicável (sb_publishable_...). Só o backend usa a chave.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
