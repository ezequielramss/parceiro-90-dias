# Copie para evolution/.env (que o Git ignora) e preencha. Nunca coloque valores neste arquivo.
# Chave global da Evolution API (gere uma longa e aleatória). Dá acesso a todas as instâncias.
AUTHENTICATION_API_KEY=
# Senha do Postgres que só a Evolution usa (gere uma longa e aleatória).
POSTGRES_PASSWORD=
